{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "gitlab/duo-chat",
  "small_model": "gitlab/duo-chat-haiku-4-5",
  "share": "disabled",
  "autoupdate": true,
  "server": {
    "hostname": "127.0.0.1",
    "mdns": false
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "skill": "allow",

    "bash": {
      "find *": "allow",
      "git commit*": "ask",
      "git commit *": "ask",
      "git push*": "ask",
      "git push *": "ask",
      "rm -rf *": "deny",
      "wget *": "deny",
      "find /": "deny",
      "find / *": "deny"
    },

    "external_directory": "ask",
    "doom_loop": "ask",
    "~/.aws/*": "deny",
    "~/.gnupg/*": "deny",
    "~/.netrc": "deny",
    "~/.ssh/*": "deny"
  },
  "plugin": [
    "opencode-skills",
    "@gitlab/opencode-gitlab-plugin",
    "@gitlab/opencode-gitlab-auth",
    "opencode-agent-memory@0.2.0",
    "opencode-mermaid-formatter",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "gitlab": {
      "options": {
        "instanceUrl": "https://gitlab.com",
        "featureFlags": {
          "duo_agent_platform_agentic_chat": true,
          "duo_agent_platform": true
        }
      },
      "models": {
        "duo-chat-haiku-4-5": {
          "cost": {
            "input": 0.8,
            "output": 4
          }
        },
        "duo-chat-sonnet-4-5": {
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "duo-chat-opus-4-5": {
          "cost": {
            "input": 15,
            "output": 75
          }
        },
        "duo-chat-haiku-4-6": {
          "cost": {
            "input": 0.8,
            "output": 4
          }
        },
        "duo-chat-sonnet-4-6": {
          "cost": {
            "input": 3,
            "output": 15
          }
        },
        "duo-chat-opus-4-6": {
          "cost": {
            "input": 15,
            "output": 75
          }
        }
      }
    },
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LlamaCPP",
      "options": {
        "baseURL": "http://skardesk:8080/v1"
      },
      "models": {
        "Qwen3.8-27B-Q4_K_M": { "name": "Qwen3.8-27B-Q4_K_M" },
        "mmproj-Qwen3.8-27B-f16": { "name": "mmproj-Qwen3.8-27B-f16" },
        "qwen2.5-coder-7b-instruct-q4_k_m": { "name": "qwen2.5-coder-7b-instruct-q4_k_m" }
      }
    }
  },
  "mcp": {
    "gcloud": {
      "type": "local",
      "command": ["npx", "-y", "@google-cloud/gcloud-mcp"],
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
      "enabled": true,
      "env": {
        "KUBECONFIG": "/Users/skarbek/.kube/config"
      }
    },
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "git fetch*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git status*": "allow",
          "git branch*": "allow",
          "git show*": "allow"
        },
        "edit": {
          "*": "ask",
          "~/projects/scratchpad/*.md": "allow"
        },
        "external_directory": {
          "~/projects/scratchpad/**": "allow"
        }
      }
    }
  }
}
