{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "gitlab/duo-chat",
  "small_model": "gitlab/duo-chat-haiku-4-5",
  "share": "disabled",
  "autoupdate": true,
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "git commit*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "find /", "effect": "deny" },
    { "action": "shell", "resource": "find / *", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },

    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" }
  ],
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "https://cdrstable.dev/api/v2/ai-gateway/anthropic/v1"
      }
    },
    "llamacpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LlamaCPP",
      "settings": {
        "baseURL": "http://skardesk:8080/v1"
      },
      "models": {
        "Qwen3.8-27B-Q4_K_M": { "name": "Qwen3.8-27B-Q4_K_M" },
        "mmproj-Qwen3.8-27B-f16": { "name": "mmproj-Qwen3.8-27B-f16" },
        "qwen2.5-coder-7b-instruct-q4_k_m": { "name": "qwen2.5-coder-7b-instruct-q4_k_m" }
      }
    }
  },
  "mcp": {
    "servers": {
      "gcloud": {
        "type": "local",
        "command": ["npx", "-y", "@google-cloud/gcloud-mcp"]
      },
      "kubernetes": {
        "type": "local",
        "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
        "disabled": true,
        "environment": {
          "KUBECONFIG": "/Users/skarbek/.kube/config"
        }
      },
      "grep-app": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      }
    }
  },
  "agents": {
    "plan": {
      "permissions": [
        { "action": "shell", "resource": "git fetch*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "~/projects/scratchpad/*.md", "effect": "allow" },
        { "action": "external_directory", "resource": "~/projects/scratchpad/**", "effect": "allow" }
      ]
    }
  }
}
